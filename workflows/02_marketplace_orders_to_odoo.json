    {
      "parameters": {
        "jsCode": "const input = $input.first().json;\nconst tp = $('Loop Over Items').first().json.total_price;\nconst total_price = Number((tp.amount + tp.vat_amount).toFixed(1));\n\nconst odooItems = (input.odoo_items || []).map(item => {\n  let default_code = item.default_code || \"\";\n  if (default_code.startsWith(\"SKU-\")) {\n    default_code = default_code.slice(5); // strip the SKU prefix\n  }\n  return { ...item, cleaned_default_code: default_code };\n});\n\nconst cdonItems = input.cdon_order_items || [];\nconst seenOdooIds = new Set();\n\nconst matchedData = (Array.isArray(cdonItems) ? cdonItems : [])\n  .map(cdonItem => {\n    const matchedOdooItem = odooItems.find(odooItem =>\n      odooItem.x_studio_plenty_id === cdonItem.sku || \n      odooItem.cleaned_default_code === cdonItem.sku\n    );\n\n    if (!matchedOdooItem) return null;\n\n    if (seenOdooIds.has(matchedOdooItem.id)) return null;\n    seenOdooIds.add(matchedOdooItem.id);\n\n    return {\n      ...cdonItem,\n      matched_odoo_id: matchedOdooItem.id,\n      matched_odoo_name: matchedOdooItem.name ?? null,\n      matched_odoo_barcode: matchedOdooItem.barcode ?? null,\n      matched_odoo_plenty_id: matchedOdooItem.x_studio_plenty_id ?? null,\n      matched_odoo_default_code: matchedOdooItem.default_code ?? null\n    };\n  })\n  .filter(item => item !== null);\n\n// Sum of matched order lines\nconst total_sum = matchedData.reduce((sum, item) => {\n  const price = +item.price_unit;\n  const qty = +item.quantity;\n  return sum + price * qty;\n}, 0);\n\nconst total_sum_fixed = +total_sum.toFixed(1);\nconst check_sum = total_sum_fixed === +total_price;\n\nreturn [{\n  matchedData,\n  total_sum: total_sum_fixed,\n  total_price,\n  check_sum\n}];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
