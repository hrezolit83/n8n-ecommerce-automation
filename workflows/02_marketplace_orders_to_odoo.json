        "jsCode": "\nconst input = $('Loop Over Items').all();\n\nconst preparedArreyOfGoods = input.map(el => ({\n  sku: el.json.article_sku,\n  quantity: el.json.quantity,\n  price_unit: Number(el.json.price.amount) + Number(el.json.price.vat_amount),\n  title: el.json.title\n}));\n\nconst checkItemExistInOdoo = preparedArreyOfGoods.map(el => el.sku);\n\nreturn {preparedArreyOfGoods, checkItemExistInOdoo};\n"
