    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "12a19005-5bb8-4a29-a3ae-babd335e7ae3",
              "name": "address",
              "value": "={{ $('Loop Over Items').first().json.shipping_address }}",
              "type": "object"
            },
            {
              "id": "b3764d5d-ce3a-476b-8a82-4b248e4c4bc9",
              "name": "type",
              "value": "contact",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        -4640,
        -864
      ],
      "id": "326cfeef-540b-47a1-bb2d-b32ff2cd079d",
      "name": "Set shipping address"
    },
    {
      "parameters": {
        "jsCode": "const found_customers = $('Get Customer type=contact Odoo').first().json.result || [];\nconst phone = $('Make Query').first().json.phone;\n\n// 1. No customers found: return an empty object\nif (found_customers.length === 0) {\n    return { customer: {} };\n}\n\n// Parse a multi-line Odoo address\nfunction parseAddress(addressStr) {\n    if (!addressStr) return {};\n\n    const parts = addressStr.split('\\n').filter(p => p.trim() !== '');\n    // Expected format:\n    // [0] street\n    // [1] city (may include zip)\n    // [2] country\n    const street = parts[0] || '';\n    const cityLine = parts[1] || '';\n    const country = parts[2] || '';\n\n    // Extract zip code (if any) and city\n    const zipMatch = cityLine.match(/(\\d{3,5})/); // 3–5 digit number\n    const zip_code = zipMatch ? zipMatch[1] : '';\n    const city = cityLine.replace(zip_code, '').trim();\n\n    return { street, city, country, zip_code };\n}\n\n// 2. Exactly one customer: return it\nif (found_customers.length === 1) {\n    const customer = found_customers[0];\n    customer.contact_address = parseAddress(customer.contact_address);\n    return { customer };\n}\n\n// 3. Several customers: narrow down by phone\nif (found_customers.length > 1) {\n  let customer;\n  if (phone) {\n    // Exact match on phone or mobile\n    customer = found_customers.find(c => phone === c.phone || phone === c.mobile);\n  }\n  // Fallback: take the first one\n  customer = customer || found_customers[0];\n\n  customer.contact_address = parseAddress(customer.contact_address);\n  return { customer };\n}\n\nreturn { customer: {} };\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -4128,
        -864
      ],
      "id": "b4fd5109-0af2-4e83-af4d-f65ebeb9a694",
      "name": "Search exact Customer"
    },
    {
      "parameters": {
        "jsCode": "const type = $input.first().json.type;\nconst email = $input.first().json.customerEmail || null;\nconst addr = $input.first().json.address || {};\n\nconst phone = [addr?.phone_number]\n  .find(p => typeof p === \"string\" && p.trim().length > 0) || null;\n\n// Base filter: type, city, street\nlet query = [\n  [\"type\", \"=\", type],\n  [\"city\", \"ilike\", addr.city],\n  [\"street\", \"ilike\", addr.street_address],\n];\n\nif (email) {\n  // Match by email\n  query.push([\"email\", \"=\", email]);\n} else if (phone) {\n  // No email but a phone: match by phone\n  query.push(\"|\", [\"mobile\", \"=\", phone], [\"phone\", \"=\", phone]);\n};\n// Also match first and last name\nquery.push([\"name\", \"ilike\", addr.last_name], [\"name\", \"ilike\", addr.first_name]);\n\nreturn [{ json: { query, phone, email} }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -4464,
        -864
      ],
