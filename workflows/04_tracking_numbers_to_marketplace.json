    {
      "parameters": {
        "method": "POST",
        "url": "={{ $json.odoProdUrl }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n    \"jsonrpc\": \"2.0\",\n    \"method\": \"call\",\n    \"params\": {\n        \"service\": \"object\",\n        \"method\": \"execute_kw\",\n        \"args\": [\n            \"{{$json.odoo_name_sql}}\",\n            \"{{$json.odoo_id_user_api}}\",\n            \"{{ $json.odoo_api }}\",\n            \"stock.picking\",\n            \"read\",\n            [{{ $('Start').first().json.body.id }}],\n            {\n                \"fields\": [\n                  \"x_studio_delivery_provider_id\", \n                  \"x_studio_order_website_id\", \n                  \"x_studio_referer_order_number\", \n                  \"carrier_tracking_ref\",\n                  \"x_studio_delivery_provider_id\"\n                ]\n            }\n        ]\n    }\n}\n",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        384,
        160
      ],
      "id": "b93cf18d-8df5-4dc6-b17e-a74882e044f3",
      "name": "Get Move Data",
      "retryOnFail": true,
      "waitBetweenTries": 3000
    },
    {
      "parameters": {
        "jsCode": "const carrierNamesOfCdon = [\n  \"Airmee\",\n  \"Asendia\",\n  \"Budbee\",\n  \"Posten Bring\",\n  \"Bpost\",\n  \"Chronopost\",\n  \"Colissimo\",\n  \"CityMail\",\n  \"FedEx\",\n  \"DAO\",\n  \"DB Schenker\",\n  \"DHL\",\n  \"DPD\",\n  \"Early Bird\",\n  \"GLS\",\n  \"Helthjem\",\n  \"Instabox\",\n  \"Matkahuolto\",\n  \"Posti\",\n  \"PostNL\",\n  \"PostNord\",\n  \"YunExpress\",\n  \"UPS\"\n];\n\nconst carrier = $('Processing Move Data').first().json.carrierName?.toLowerCase() || '';\n\nconst carrierName = carrierNamesOfCdon.find(c =>\n  carrier.includes(c.toLowerCase())\n);\n\nconst isProvider = !!carrierName;\n\nreturn { isProvider, carrierName: carrierName || null };"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1168,
        160
      ],
      "id": "ab2936f4-f4eb-4897-a5ad-48268e54d436",
      "name": "Get Cdon CarrierName"
    }
