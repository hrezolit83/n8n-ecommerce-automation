    },
    {
      "parameters": {
        "jsCode": "const countryOfStore = [87, 88, 89];\n\nconst websiteId = $input.first().json.websiteId;\n\nconst isStoreCdon = countryOfStore.includes(websiteId);\n\nreturn {isStoreCdon, websiteId };\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        752,
        160
      ],
