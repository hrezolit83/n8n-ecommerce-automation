        "jsonBody": "={\n  \"TASKID\": {{ $('Task id').first().json.task_id }},    \n  \"FIELDS\": {\n    \"POST_MESSAGE\": \"[B][SIZE=3]Найден еще один минусовый ордер:[/SIZE][/B] \\\\n\\\\n  Ссылка на ордер: https://your-instance.example.com/odoo/orders/{{ $('Start').first().json.order_id }} \\\\n\\\\n Минусовая маржа: {{ $('Start').first().json.margin }}\"\n  }\n}",
