      "parameters": {
        "jsCode": "let websites = $('Available Websites').first().json.result;\n\nlet products_to_update = $('Start').first().json.products;\n\nlet result = websites.flatMap(website => \n    products_to_update.map(product => ({\n        x_name: product.id.toString() + \" | \" + website.name + \" | \" + product.default_code,\n        x_studio_product: product.id, \n        x_studio_website: website.id\n    }))\n);\n\nreturn {\n  all_websites_products: result\n}\n\n"
      },
