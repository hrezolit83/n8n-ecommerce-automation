        "rawContentType": "application/json; charset=utf-8",
        "body": "={\n  \"jsonrpc\": \"2.0\",\n  \"method\": \"call\",\n  \"params\": {\n    \"service\": \"object\",\n    \"method\": \"execute_kw\",\n    \"args\": [\n      \"{{ $json.odoo_name_sql }}\",\n      {{ $json.odoo_id_user_api }},\n      \"{{ $json.odoo_api }}\",\n      \"website\",\n      \"search_read\",\n      [\n          [\n              [\"x_studio_available_for_price_sync\", \"=\", \"true\"],\n              [\"id\", \"not in\", [87,89,200,201,202,121,192,191,94,187,91,198,199,190,93,188,92,120,96,95,98,97,112,39,170,174,42,173,40,171,35,167,41,172,37,168,38,169,175,47,50,48,44,49,45,46]]\n          ]\n      ],\n      {\n          \"fields\": [\n            \"id\", \n            \"name\"\n          ]\n      }\n    ]\n  }\n}\n",
