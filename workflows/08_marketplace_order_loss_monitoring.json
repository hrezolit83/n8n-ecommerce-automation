    {
      "parameters": {
        "jsCode": "let  date = $now.plus({ hours: 3 })\n\n// Проверка дня недели (1 = понедельник, 7 = воскресенье)\nlet day = date.weekday;\nlet hour = date.hour;\n\n// Если выходные → переносим на понедельник 12:00\nif (day === 6) { // суббота\n  date = date.plus({ days: 2 }).set({ hour: 12, minute: 0, second: 0 });\n} else if (day === 7) { // воскресенье\n  date = date.plus({ days: 1 }).set({ hour: 12, minute: 0, second: 0 });\n} else {\n  // Если нерабочее время (до 9 или после 19) → следующий рабочий день в 12:00\n  if (hour < 9 || hour >= 19) {\n    date = date.plus({ days: 1 }).set({ hour: 12, minute: 0, second: 0 });\n    \n    // Если следующий день оказался выходным — переносим на понедельник\n    let nextDay = date.weekday;\n    if (nextDay === 6) { // суббота\n      date = date.plus({ days: 2 });\n    } else if (nextDay === 7) { // воскресенье\n      date = date.plus({ days: 1 });\n    }\n  }\n}\n  \nreturn  { deadline: date.toFormat('yyyy-MM-dd HH:mm:ss') } "
      },
