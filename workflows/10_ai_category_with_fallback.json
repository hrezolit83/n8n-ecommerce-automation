pping_height\",\n                    \"feed_color\",\n                    \"feed_material\",\n                    \"energy_efficiency_class\",\n                    \"x_studio_manufacturer_name\",\n                    \"x_studio_basic_quantity\",\n                    \"x_studio_basic_units\",\n                    \"name\",\n                    \"website_description\",\n                    \"x_studio_parent_sku\",\n                    \"x_studio_eu_responsible_name\",\n                    \"x_studio_eu_responsible_street\",\n                    \"x_studio_eu_responsible_house_no\",\n                    \"x_studio_eu_responsible_town\",\n                    \"x_studio_eu_responsible_post_code\",\n                    \"x_studio_eu_responsible_country\",\n                    \"x_studio_eu_responsible_email\",\n                    \"x_studio_eu_responsible_phone_number\",\n                    \"image_1920\"\n                ],\n                \"context\": {\n                    \"lang\": \"de_DE\"\n                }\n            }\n        ]\n    }\n}",
