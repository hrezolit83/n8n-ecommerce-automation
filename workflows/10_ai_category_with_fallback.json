    {
      "parameters": {
        "jsCode": "const product = $('get product odoo').first().json;\nconst textToCheck = (product.name || \"\") + \" \" + (product.category_name || \"\");\n\nif ((product.name || \"\").includes(\"Weekiss\")) {\n  return {\n    id: 20802 \n  };\n}\n\nconst gardenKeywords = [\n  \"Rasenkantenband\",\n  \"Rasenkanten\",\n  \"Beeteinfassung\",\n  \"Beetumrandung\",\n  \"Beetbegrenzungen\"\n];\nif (gardenKeywords.some(word => textToCheck.includes(word))) {\n  return {\n    id: 22578 \n  };\n}\n\nconst drinkKeywords = [\n  \"Bierzapfen\",\n  \"Bierkühler\",\n  \"Zapfanlage\",\n  \"Durchlaufkühler\",\n  \"Trockenkühler\"\n];\nif (drinkKeywords.some(word => textToCheck.includes(word))) {\n  return {\n    id: 16142 \n  };\n}\n\nconst glassCategoryMap = {\n  \"Cocktailgläser\": 14560,\n  \"Longdrinkgläser\": 14564,\n  \"Schnapsgläser\": 14569,\n  \"Sektgläser\": 14568,\n  \"Weingläser\": 14571,\n  \"Whiskygläser\": 14572\n};\nfor (const [keyword, categoryId] of Object.entries(glassCategoryMap)) {\n  if (textToCheck.includes(keyword)) {\n    return {\n      id: categoryId \n    };\n  }\n}\n\nif (textToCheck.includes(\"Shaker\")) {\n  return {\n    id: 12347\n  };\n}\n\nconst pourKeywords = [\"Portionierer\", \"Ausgießer\", \"Flaschenausschank\"];\nif (pourKeywords.some(word => textToCheck.includes(word))) {\n  return {\n    id: 16117\n  };\n}\n\n// Якщо нічого не підійшло\nreturn {id: 0 };\n"
      },
