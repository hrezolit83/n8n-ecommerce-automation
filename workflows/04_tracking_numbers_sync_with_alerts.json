      "parameters": {
        "jsCode": "const defined_curriers = $('Shipping profiles').first().json.profiles;\nconst otto_products = $('Get products by SKU').first().json;\nconst odoo_products = $('Merge transfers data').first().json.data.map(item => item.products).flatMap(item => item);\nconst ship_date = DateTime.fromFormat($('Otto order').first().json.effective_date, 'yyyy-MM-dd HH:mm:ss', { zone: 'UTC' }).toFormat(\"yyyy-MM-dd'T'HH:mm:ss.SSS'Z'\");\nconst order_number = $('Otto order').first().json.x_studio_source_order_number;\nconst otto_order_data = $('Get Otto orders').first().json.resources.find(order => order.orderNumber === order_number);\n\nfunction mergeProducts(odoo_products, otto_products) {\n    // Групуємо odoo_products за product_sku\n    let odooMap = new Map();\n    odoo_products.forEach(product => {\n        if (!odooMap.has(product.product_sku)) {\n            odooMap.set(product.product_sku, []);\n        }\n        odooMap.get(product.product_sku).push({\n            qty: product.product_qty,\n            tracknumber: product.tracknumber,\n            return_tracknumber: product.return_tracknumber,\n            carrier: product.carrier\n        });\n    });\n\n    // Фільтруємо та додаємо tracknumber і carrier до otto_products\n    const result = [];\n    const skuCount = new Map(); // Лічильник для кожного SKU\n\n    otto_products.products.forEach(product => {\n        const sku = product.default_code;\n        const odooEntries = odooMap.get(sku);\n\n        if (odooEntries) {\n            // Ініціалізуємо лічильник для цього SKU, якщо ще не існує\n            if (!skuCount.has(sku)) {\n                skuCount.set(sku, { index: 0, count: 0 });\n            }\n\n            const tracker = skuCount.get(sku);\n            let added = false;\n\n            // Перебираємо записи для цього SKU\n            for (let i = tracker.index; i < odooEntries.length; i++) {\n                const entry = odooEntries[i];\n                if (tracker.count < entry.qty) {\n                    result.push({\n                        ...product,\n                        tracknumber: entry.tracknumber,\n                        return_tracknumber: entry.return_tracknumber,\n                        carrier: entry.carrier\n                    });\n                    tracker.count++;\n                    added = true;\n                    break;\n                } else {\n                    // Якщо поточний запис вичерпав qty, переходимо до наступного\n                    tracker.index++;\n                    tracker.count = 0;\n                }\n            }\n\n            // Оновлюємо лічильник\n            skuCount.set(sku, tracker);\n\n            // Якщо не додали об'єкт (наприклад, qty вичерпано), пропускаємо\n            if (!added) {\n                result.push({ ...product });\n            }\n        } else {\n            // Якщо немає відповідного SKU в odoo_products, додаємо без змін\n            result.push({ ...product });\n        }\n    });\n\n    return { products: result };\n}\n\nconst tracknumber_groups = {};\nmergeProducts(odoo_products, otto_products).products.forEach(item => {\n  const { positionItemId, carrier, tracknumber, return_tracknumber } = item;\n  const product = {\n    carrier_data: {\n      carrier,\n      tracknumber\n    },\n    positionItemId,\n    salesOrderId: otto_order_data?.salesOrderId,\n    returnTrackingKey: {\n      carrier: 'DHL',\n      trackingNumber: return_tracknumber\n    }\n  };\n\n  if (!tracknumber_groups[tracknumber]) {\n    tracknumber_groups[tracknumber] = [product];\n  } else {\n    tracknumber_groups[tracknumber].push(product);\n  }\n});\n\nconst api_calls = [];\nfor (const item in tracknumber_groups) {\n  const call = {\n    'trackingKey': {\n      'carrier': defined_curriers[tracknumber_groups[item][0].carrier_data.carrier],\n      'trackingNumber': item\n    },\n    'shipDate': ship_date,\n    'shipFromAddress': {\n      'city': otto_order_data?.deliveryAddress.city,\n      'countryCode': otto_order_data?.deliveryAddress.countryCode,\n      'zipCode': otto_order_data?.deliveryAddress.zipCode\n    },\n    'positionItems': tracknumber_groups[item].map(product => {\n      const position = {\n        \"positionItemId\": product.positionItemId,\n        \"salesOrderId\": product.salesOrderId\n      };\n\n      if (product.returnTrackingKey.trackingNumber) {\n        position.returnTrackingKey = product.returnTrackingKey;\n      }\n      \n      return position;\n    })\n  };\n\n  api_calls.push(call);\n}\n\n// return { ...mergeProducts(odoo_products, otto_products) };\n// return { tracknumber_groups }\nreturn { api_calls };"
      },
