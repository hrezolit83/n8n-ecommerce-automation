        "body": "={\n    \"jsonrpc\": \"2.0\",\n    \"method\": \"call\",\n    \"params\": {\n        \"service\": \"object\",\n        \"method\": \"execute_kw\",\n        \"args\": [\n            \"{{ $('ACME | Odoo').item.json.x_studio_sql_name }}\",\n            {{ $('ACME | Odoo').item.json.x_studio_user }},\n            \"{{ $('ACME | Odoo').item.json.x_studio_api }}\",\n            \"stock.move\",\n            \"search_read\",\n            [[\n              [\"id\", \"in\", [{{ $(\"Split Moves\").item.json.move_ids }}]]\n            ]],\n            {\n              \"fields\": [\n                \"product_id\",\n                \"product_tmpl_id\",\n                \"product_qty\",\n\t\t\t\t\"weight\",\n                \"description_bom_line\",\n                \"x_studio_bom_lines_of_parent_bom\",\n                \"bom_line_id\"\n              ]\n            }\n        ]\n    }\n}\n ",
        "options": {}
