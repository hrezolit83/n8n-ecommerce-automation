    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('ACME | Odoo').first().json.x_studio_base_url }}",
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={\n    \"jsonrpc\": \"2.0\",\n    \"method\": \"call\",\n    \"params\": {\n        \"service\": \"object\",\n        \"method\": \"execute_kw\",\n        \"args\": [\n            \"{{ $('ACME | Odoo').first().json.x_studio_sql_name }}\",\n            {{ $('ACME | Odoo').first().json.x_studio_user }},\n            \"{{ $('ACME | Odoo').first().json.x_studio_api }}\",\n            \"sale.order.line\",\n            \"search_read\",\n            [[\n              [\"id\", \"in\", [{{ $(\"Otto order\").item.json.order_line }}]],\n              [\"product_type\", \"!=\", \"service\"],\n              [\"qty_delivered\", \">\", 0]\n            ]],\n            {\n              \"fields\": [\n                \"product_type\",\n                \"product_template_id\",\n                \"price_unit\",\n                \"product_uom_qty\",\n                \"qty_delivered\",\n                \"tax_id\"\n              ]\n            }\n        ]\n    }\n}\n ",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1136,
        192
      ],
      "id": "76d6d96c-c122-47dc-b6d4-e2f4ed967b9c",
      "name": "Lines list",
      "retryOnFail": true,
      "waitBetweenTries": 5000,
      "maxTries": 5
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const move_name = $('Split Moves').item.json.name;\nlet error_msg = '';\nlet proccess_error = '';\n\nconst tracknumber = $('Split Moves').item.json.carrier_tracking_ref;\nconst return_tracknumber = $('Split Moves').item.json.x_studio_return_tracking_reference;\nconst carrier = $('Split Moves').item.json.x_studio_delivery_provider_id[1];\n\nconst moves = $('Product moves').item.json.result.map(item => {\n  let is_bandle = false;\n  const product_id = item.product_tmpl_id[0];\n  const original_product_sku = item.product_tmpl_id[1].match(/\\[(.*?)\\]/)[1];\n  let product_sku = item.product_tmpl_id[1].match(/\\[(.*?)\\]/)[1];\n  if (item.description_bom_line) {\n    is_bandle = true;\n    product_sku = item.description_bom_line.match(/\\[(.*?)\\]/)[1];\n  }\n\n  return {\n    product_id,\n    original_product_sku,\n    product_sku,\n    product_qty: item.product_qty,\n    is_bandle\n  }\n});\n\nconst combinedMoves = Object.values(\n  moves.reduce((acc, move) => {\n    if (!acc[move.product_sku]) {\n      acc[move.product_sku] = move;\n    }\n\n    return acc;\n  }, {})\n);\n\nconst order_lines = $('Lines list').item.json.result\n  .filter(item => item.product_uom_qty)\n  .filter(item => item.price_unit)\n  .map(item => {\n  const { product_template_id } = item;\n  let product_sku = '';\n  const match = item.product_template_id[1].match(/\\[(.*?)\\]/)\n  if (match) {\n    product_sku = match[1];\n  }\n\n  return { product_id: product_template_id[0], product_sku }\n});\n\nconst products = combinedMoves.map(move => {\n  const product = order_lines.find(line => line.product_sku === move.product_sku);\n\n  if (!product) {\n    if (move.is_bandle) {\n      proccess_error = `Product ${move.original_product_sku} is a part of bundle ${move.product_sku}, but order doesnt contian this bundle. Transfer: ${move_name}`;\n    }\n\n    error_msg = `Товар ${move.product_sku} не нашел свой бандл в трансфере ${move_name}`; \n  }\n\n  return {\n    ...product,\n    product_move_id: move.product_move_id,\n    product_qty: move.product_qty,\n    tracknumber,\n    return_tracknumber,\n    carrier\n  }\n});\n\nreturn { products, error_msg, proccess_error };"
      },
