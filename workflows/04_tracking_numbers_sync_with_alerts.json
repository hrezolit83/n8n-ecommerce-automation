        "specifyBody": "json",
        "jsonBody": "={\n    \"jsonrpc\": \"2.0\",\n    \"method\": \"call\",\n    \"params\": {\n        \"service\": \"object\",\n        \"method\": \"execute_kw\",\n        \"args\": [\n            \"{{ $('ACME | Odoo').first().json.x_studio_sql_name }}\",\n            {{ $('ACME | Odoo').first().json.x_studio_user }},\n            \"{{ $('ACME | Odoo').first().json.x_studio_api }}\",\n            \"stock.picking\",\n            \"search_read\",\n            [[\n              [\"id\", \"in\", [{{ $(\"Otto order\").item.json.picking_ids }}]],\n              [\"picking_type_id\", \"in\", [2, 13, 14, 28]],\n              [\"state\", \"not in\", [\"draft\", \"waiting\", \"confirmed\", \"assigned\", \"picking\", \"cancel\"]]\n            ]],\n            {\n              \"fields\": [\n                \"product_id\",\n                \"carrier_tracking_ref\",\n                \"x_studio_return_tracking_reference\",\n                \"x_studio_delivery_provider_id\",\n                \"move_ids\",\n                \"state\"\n              ]\n            }\n        ]\n    }\n}",
