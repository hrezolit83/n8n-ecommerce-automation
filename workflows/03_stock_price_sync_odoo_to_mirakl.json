    {
      "parameters": {
        "jsCode": "const websitesData = [\n    {\n        websiteId: 95,\n        pricelist_id: 3,\n        locale_code: \"fr_FR\",\n        description: \"Leroy Merlin France channel\",\n        label: \"LMFR\"\n    },\n    {\n        websiteId: 96,\n        pricelist_id: 24,\n        locale_code: \"es_ES\",\n        description: \"Leroy Merlin Spain channel\",\n        label: \"LMES\"\n    },\n    {\n        websiteId: 97,\n        pricelist_id: 20,\n        locale_code: \"pt_PT\",\n        description: \"Leroy Merlin Portugal channel\",\n        label: \"LMPT\"\n    },\n    {\n        websiteId: 98,\n        pricelist_id: 15,\n        locale_code: \"it_IT\",\n        description: \"Leroy Merlin Italy channel\",\n        label: \"LMIT\"\n    }\n    // {\n    //     websiteId: null,\n    //     pricelist_id: null,\n    //     locale_code: \"pl_PL\",\n    //     description: \"\",\n    //     label: \"\"\n    // }\n];\n\nreturn { websitesData };\n"
