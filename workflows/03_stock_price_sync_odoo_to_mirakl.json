      "retryOnFail": true,
      "waitBetweenTries": 5000
    },
    {
      "parameters": {
        "jsCode": "const responseAdeo = $input.first().json.offers;\n\nconst arrayFromAdeo = responseAdeo.map(el => ({\n    sku: el.shop_sku,\n    stockAdeo: el.quantity,\n    priceAdeo: el.price,\n    leadToShipTimeAdeo: el.leadtime_to_ship,\n    logisticAdeo: el.logistic_class.code,\n}));\n\nreturn {arrayFromAdeo};\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -320,
        464
      ],
      "id": "7ade463b-2135-4b28-a1ad-7e4e13cf3bdf",
      "name": "Processing Data from Adeo"
    },
    {
      "parameters": {
        "jsCode": "let pricesByCountry = $input.all().map(item => item.json); \nconst allProducts = $('Get Items Odoo').first().json.result;\n\nconst merged = pricesByCountry.map(priceItem => {\n  // Беремо id з самого елемента\n  const product_id = priceItem.product_tmpl_id?.[0]; \n  \n  const product = allProducts.find(p => p.id === product_id);\n\n  return {\n    json: {\n      product_id,\n      ...priceItem,\n      ...(product || {})\n    }\n  };\n});\n\nreturn merged;\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -1344,
        448
      ],
      "id": "29c50d14-510f-42bd-b48f-f9d056978e48",
      "name": "Agregate Data"
    },
    {
      "parameters": {
        "aggregate": "aggregateAllItemData",
        "destinationFieldName": "=products_{{ $('Get Price').first().json.pricelist_id[1].split(\" \")[0] }}",
        "options": {}
      },
      "type": "n8n-nodes-base.aggregate",
      "typeVersion": 1,
      "position": [
        -1184,
        448
      ],
      "id": "1672f195-fd96-4eb7-a18a-8fb8093ae597",
      "name": "Gruped by Lang"
    },
    {
      "parameters": {
        "jsCode": "const input = $input.all().map(i => i.json);\n\nconst merged = {};\n\ninput.forEach(countryBlock => {\n  const [countryKey, products] = Object.entries(countryBlock)[0]; \n  const countryName = countryKey.replace(\"products_\", \"\"); \n\n  products.forEach(product => {\n    const productId = product.product_tmpl_id[0]; \n    const rawCode = product.default_code || \"\";\n    const cleanSKU = rawCode.replace(/^SKU-/, \"\"); \n\n    function getLogisticClass(product_tag_ids) {\n  switch (true) {\n    case product_tag_ids.includes(9):\n      return \"FREE\"\n\n    case product_tag_ids.includes(2):\n      return 'M';\n\n    case product_tag_ids.includes(1):\n      return \"XS\"\n  }\n};\n\n\n    // створюємо або оновлюємо об’єкт\n    merged[productId] = {\n      ...(merged[productId] || {}),\n      product_id: productId,\n      sku: cleanSKU,\n      plentyId: product.x_studio_plenty_id,\n      name: product.name,\n      stockOdoo: product.x_studio_free_to_use,\n      logisticOdoo: getLogisticClass(product.product_tag_ids),\n      // одразу рахуємо максимум\n      priceOdoo: Math.max(\n        merged[productId]?.priceOdoo || 0,\n        product.fixed_price || 0\n      ),\n      [`${countryName}_price`]: product.fixed_price\n    };\n  });\n});\n\nreturn { arrayFromOdoo: Object.values(merged) };\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -1504,
        224
      ],
      "id": "23a49931-d0f8-493a-965e-816166ca4fa9",
      "name": "Processing Data from Odoo"
    },
    {
      "parameters": {
        "jsCode": "const arrayFromOdoo = $('Processing Data from Odoo').first().json.arrayFromOdoo;\nconst arrayFromAdeo = $('Processing Data from Adeo').first().json.arrayFromAdeo;\n\nconst matchedProducts = arrayFromOdoo.map(odooItem => {\n  if (odooItem.sku && odooItem.sku.startsWith('SKU-')) {\n    odooItem.sku = odooItem.sku.slice(5);\n  }\n  \n  const matched = arrayFromAdeo.find(adeoItem => \n    (odooItem.plentyId && odooItem.plentyId === adeoItem.sku) || odooItem.sku === adeoItem.sku\n  );\n\n  if (matched) {\n    // якщо ціна і сток однакові — пропускаємо\n    if (\n      matched.priceAdeo === odooItem.priceOdoo &&\n      matched.stockAdeo === odooItem.stockOdoo &&\n      matched.logisticAdeo === odooItem.logisticOdoo\n    ) {\n      return null;\n    }\n\n    // Визначаємо, яке саме значення збіглося\n    const matched_sku = (odooItem.plentyId && odooItem.plentyId === matched.sku) \n      ? odooItem.plentyId \n      : odooItem.sku;\n\n    return { ...odooItem, matched_sku };\n  }\n\n  return null; // не матчиться\n}).filter(Boolean); // прибираємо null\n\nreturn { matchedProducts };\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -160,
        464
      ],
      "id": "cb7b8194-edc9-4e54-b9d3-ac4b5e25bd98",
      "name": "Compare Data",
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "const matchedProducts = $input.first().json.matchedProducts;\n\nconst offers = matchedProducts.map(el => {\n    const maxPrice = Math.max(\n        el.France_price || 0,\n        el.Spain_price || 0,\n        el.Portugal_price || 0,\n        el.Italy_price || 0\n    );\n\n    return {\n        \"all_prices\": [\n          {\n            \"channel_code\": \"001\",\n            \"unit_origin_price\": el.France_price\n          },\n          {\n            \"channel_code\": \"002\",\n            \"unit_origin_price\": el.Spain_price\n          },\n          {\n            \"channel_code\": \"003\",\n            \"unit_origin_price\": el.Portugal_price\n          },\n          {\n            \"channel_code\": \"005\",\n            \"unit_origin_price\": el.Italy_price\n          }\n        ],\n        quantity: el.stockOdoo,\n        shop_sku: el.matched_sku,\n        update_delete: \"update\",\n        price: maxPrice,\n        state_code: \"11\",\n        logistic_class: el.logisticOdoo\n    };\n});\n\nreturn { offers };\n"
      },
